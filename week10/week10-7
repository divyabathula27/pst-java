
Question:Display Numbers in Sorted Order

Scenario: A teacher enters students' marks, but some marks are repeated. Write a Java program using a TreeSet to display the unique marks in ascending order.


import java.util.Scanner;
import java.util.TreeSet;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        TreeSet<Integer> marks = new TreeSet<>();

        System.out.print("Enter number of students: ");
        int n = sc.nextInt();

        
        for (int i = 0; i < n; i++) {
            marks.add(sc.nextInt());
        }

    
        System.out.println("Unique Marks in Ascending Order:");

        for (int mark : marks) {
            System.out.println(mark);
        }

        sc.close();
    }
}
