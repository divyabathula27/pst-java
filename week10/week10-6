Question:Find All Unique Items Purchased

Scenario: 
A customer purchases several items, including repeated items. Write a Java program using a LinkedHashSet to display only unique items in the order they were purchased.


import java.util.LinkedHashSet;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        LinkedHashSet<String> items = new LinkedHashSet<>();

        System.out.print("Enter number of items: ");
        int n = sc.nextInt();
        sc.nextLine();

        
        for (int i = 0; i < n; i++) {
            String item = sc.nextLine();
            items.add(item);
        
        System.out.println("Unique Items:");

        for (String item : items) {
            System.out.println(item);
        }

        sc.close();
    }
}
