Question 3 – Top K Frequent Elements
Inspired by LeetCode 347
Problem
Given an integer array and an integer K, find the K most frequently occurring elements.


import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        Map<Integer, Integer> frequency = new HashMap<>();

        for (int num : nums) {
            frequency.put(num, frequency.getOrDefault(num, 0) + 1);
        }


        List<Integer> elements = new ArrayList<>(frequency.keySet());

        elements.sort((a, b) -> {
            int result = Integer.compare(frequency.get(b), frequency.get(a));
            if (result == 0) {
                return Integer.compare(a, b);
            }
            return result;
        });


        for (int i = 0; i < k && i < elements.size(); i++) {
            System.out.print(elements.get(i));
            if (i < k - 1 && i < elements.size() - 1) {
                System.out.print(" ");
            }
        }

        System.out.println();
        sc.close();
    }
}
