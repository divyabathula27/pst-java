import java.io.*;
import java.util.*;

public class Solution {

   
    static int[] manacher(String s) {
        int n = s.length();

        
        char[] t = new char[2 * n + 1];

        for (int i = 0; i < t.length; i++) {
            if (i % 2 == 0) {
                t[i] = '#';
            } else {
                t[i] = s.charAt(i / 2);
            }
        }

        int[] radius = new int[t.length];

        int center = 0;
        int right = 0;

        for (int i = 0; i < t.length; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] = Math.min(right - i, radius[mirror]);
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < t.length &&
                   t[i - radius[i] - 1] == t[i + radius[i] + 1]) {
                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        return radius;
    }

    static class SparseTable {
        int[][] table;
        int[] log;

        SparseTable(int[] arr) {
            int n = arr.length;

            log = new int[n + 1];

            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }

            int levels = log[n] + 1;
            table = new int[levels][n];

            System.arraycopy(arr, 0, table[0], 0, n);

            for (int j = 1; j < levels; j++) {
                int len = 1 << j;
                int half = len >> 1;

                for (int i = 0; i + len <= n; i++) {
                    table[j][i] = Math.max(
                        table[j - 1][i],
                        table[j - 1][i + half]
                    );
                }
            }
        }

        int query(int left, int right) {
            if (left > right) {
                return 0;
            }

            int length = right - left + 1;
            int j = log[length];

            return Math.max(
                table[j][left],
                table[j][right - (1 << j) + 1]
            );
        }
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

       
        String doubled = s + s;

       
        int[] radius = manacher(doubled);

        
        SparseTable st = new SparseTable(radius);

        StringBuilder output = new StringBuilder();

        for (int start = 0; start < n; start++) {

            /*
             * In the transformed string:
             *
             * first character of rotation:
             *     2 * start + 1
             *
             * last character of rotation:
             *     2 * (start + n - 1) + 1
             */
            int left = 2 * start + 1;
            int right = 2 * (start + n - 1) + 1;

            int low = 1;
            int high = n;
            int answer = 1;

            
            while (low <= high) {

                int len = (low + high) / 2;

                /*
                 * A palindrome of length len must have its
                 * center between these two positions.
                 */
                int centerLeft = left + len - 1;
                int centerRight = right - len + 1;

                boolean possible = false;

                if (centerLeft <= centerRight) {
                    int maxRadius =
                        st.query(centerLeft, centerRight);

                    if (maxRadius >= len) {
                        possible = true;
                    }
                }

                if (possible) {
                    answer = len;
                    low = len + 1;
                } else {
                    high = len - 1;
                }
            }

            output.append(answer).append('\n');
        }

        System.out.print(output);
    }
}
